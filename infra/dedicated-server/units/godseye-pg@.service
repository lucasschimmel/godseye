# Per-cell PostgreSQL 18 instance. Instance name = cell allocation UUID (godseye-pg@<alloc>.service).
# Installed by p10-install-pg-cells.sh. The control process never edits this unit; it only starts,
# stops and enables instances through the root cell helper (fixed verbs).
#
# Isolation notes
# - All cells share the `postgres` UID, so filesystem separation is enforced by the mount namespace:
#   every other cell's storage, configuration and sockets are invisible to this instance.
# - PGDATA and WAL live on directories of a dedicated XFS volume, each under its own XFS project with a
#   hard block limit (created by the helper verb `storage-create`); this unit never creates storage.
[Unit]
Description=G.O.D.S.E.Y.E PostgreSQL 18 cell %i
Documentation=file:///opt/godseye/docs/development/dedicated-cells.md
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/srv/godseye/pg/%i/data /srv/godseye/pg/%i/wal
ConditionPathExists=/etc/godseye/pg/%i/cell.env
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
User=postgres
Group=postgres
EnvironmentFile=/etc/godseye/pg/%i/cell.env
# Optional: the WAL archive cipher passphrase (root-owned, read by systemd, never by the cell files).
EnvironmentFile=-/etc/godseye/pg/%i/archive.env
# Optional: off-host repository credentials shared by all cells (root-owned, loaded by systemd only).
EnvironmentFile=-/etc/godseye/pg/b2.env
RuntimeDirectory=godseye-pg/%i
# Traversable by the control user (the socket itself is 0660 group godseye); not listable by others.
RuntimeDirectoryMode=0751
ExecStart=/usr/lib/postgresql/18/bin/postgres -D /srv/godseye/pg/%i/data -c config_file=/etc/godseye/pg/%i/postgresql.conf
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutStartSec=infinity
TimeoutStopSec=120
OOMScoreAdjust=-900
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s

# Mount namespace: only this cell's own paths are visible.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
TemporaryFileSystem=/srv/godseye/pg:ro /etc/godseye/pg:ro /run/godseye-pg:ro /var/lib/godseye/pg-backup:ro
BindPaths=/srv/godseye/pg/%i /run/godseye-pg/%i
BindReadOnlyPaths=/etc/godseye/pg/%i
InaccessiblePaths=-/etc/godseye/secrets -/etc/openbao -/var/lib/openbao
# pgBackRest lock/log live in the cell directory and runtime directory, already bound read-write above.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
# Per-cell CPU/memory ceilings are applied from the admitted profile (cpuMilliCores / memoryMiB);
# they are intentionally not hardcoded here.
Slice=godseye-pg.slice

[Install]
WantedBy=multi-user.target
