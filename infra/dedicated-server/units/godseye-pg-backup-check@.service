# pgBackRest WAL archive check for cell %i (hourly). TEMPLATE ONLY.
# A failing or missing check is what the E08 detector raises as an archive-lag incident.
[Unit]
Description=G.O.D.S.E.Y.E pgBackRest archive check for cell %i
After=godseye-pg@%i.service
Requires=godseye-pg@%i.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=/etc/godseye/pg/%i/archive.env
ExecStart=/usr/local/sbin/godseye-pg-backup check %i
TimeoutStartSec=10min
Nice=10
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/srv/godseye/pg/%i /var/lib/godseye/pg-backup /run/godseye-pg/%i
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
