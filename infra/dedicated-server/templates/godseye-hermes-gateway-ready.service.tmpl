# TEMPLATE - not installed or enabled by any repository command. Copy to /etc/systemd/system/ after review.
#
# The Hermes gateway and tools worker are REQUEST-SCOPED helpers: the control API launches one bounded
# child per task over stdio (scripts/hermes_gateway.py, scripts/hermes_tools_worker.py). They are not
# daemons, so these units do not run them. Each unit is a readiness gate for its helper's native
# prerequisites (uid-1000 user, private workspace, delegated cgroup + user bus for tools). Failure
# restarts with backoff; the control API orders after it with Wants= (not Requires=), so an unready
# gate degrades Hermes only and never stops owner administration.
#
# Replace @@WORKSPACE@@ with the absolute, unlinked workspace (e.g. /opt/godseye).
[Unit]
Description=G.O.D.S.E.Y.E Hermes gateway prerequisites
After=local-fs.target godseye-bindings-render.service
Wants=godseye-bindings-render.service
Before=godseye-control-api.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
User=godseye
Group=godseye
ExecStart=/usr/bin/python3 -I -B @@WORKSPACE@@/scripts/hermes_ready_check.py gateway @@WORKSPACE@@
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@@WORKSPACE@@

[Install]
WantedBy=multi-user.target
