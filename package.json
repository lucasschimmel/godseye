{
  "name": "godseye",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "bun": ">=1.4.4 <1.5"
  },
  "scripts": {
    "postgres:install": "node scripts/install-postgres.mjs",
    "postgres:recovery:install": "node scripts/install-pgbackrest.mjs",
    "test:recovery:lab": "vitest run --config vitest.recovery-lab.config.ts",
    "test:delivery:lab": "vitest run tests/delivery-lab.test.ts",
    "test:database:lab": "vitest run --config vitest.pg-lab.config.ts",
    "runsc:install": "node scripts/install-runsc.mjs",
    "test:infra:lab": "vitest run --config vitest.infra-lab.config.ts",
    "bao:install": "node scripts/install-openbao.mjs",
    "access:policy": "node --import tsx apps/control-api/src/access-cli.ts policy",
    "access:provider-auth": "node --import tsx apps/control-api/src/access-cli.ts provider-auth",
    "access:stage": "node --import tsx apps/control-api/src/access-cli.ts stage",
    "access:issue": "node --import tsx apps/control-api/src/access-cli.ts issue",
    "dev": "node scripts/dev.mjs",
    "build": "bun run --filter @godseye/console build && node scripts/build-api.mjs && bun run build:sdk && bun run build:backend",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run contracts:check && bun run typecheck && bun run test",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "ci:report": "node scripts/ci-report.mjs",
    "smoke:built": "node scripts/smoke-built.mjs",
    "test:mutation": "node scripts/mutation-check.mjs",
    "test:mutation:delivery": "node scripts/mutation-delivery-check.mjs",
    "owner:setup": "node --import tsx apps/control-api/src/owner-cli.ts setup",
    "owner:recover": "node --import tsx apps/control-api/src/owner-cli.ts recover",
    "contracts:generate": "node --import tsx scripts/contracts.mjs",
    "contracts:check": "node --import tsx scripts/contracts.mjs --check",
    "backend:dev": "node --import tsx apps/backend-template/src/server.ts",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "test:mutation:backend": "node scripts/mutation-backend-check.mjs"
  },
  "devDependencies": {
    "@godseye/core": "workspace:*",
    "@godseye/store": "workspace:*",
    "@godseye/contracts": "workspace:*",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@hono/node-server": "2.1.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "better-auth": "1.7.20",
    "@better-auth/passkey": "1.7.20",
    "@better-auth/drizzle-adapter": "1.7.20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ],
  "overrides": {
    "@esbuild-kit/core-utils>esbuild": "0.28.2"
  }
}
